# Copy this to telegram.env and fill it in yourself.
# telegram.env is gitignored and is never read by anything but notify/telegram.py.
# Nothing else in this repository ever sees or stores these values.
#
#   1. Message @BotFather on Telegram, /newbot, copy the token it gives you.
#   2. Message your new bot once, then open
#      https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
#
# Leave this file as-is if you do not want push notifications; the system falls
# back to console output and says so at startup.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Which signal channels push a message. Comma separated, no spaces.
#
# signal5 is DELIBERATELY not in the default list: it fires roughly 16 times a
# day, which is 16 phone notifications, and a stream that noisy gets muted --
# taking the other four down with it. Add it here if you want it.
#
#   rule     the measured system (long, TP/SL 25, ~rare)
#   signal2  mined, short, +/-25          ~8 per month
#   signal3  mined, long,  +/-15          ~20 per month
#   signal4  mined, refit weekly, +15/-25 ~3 per day
#   signal5  mined, short, +/-10          ~16 per DAY
#
TELEGRAM_SIGNALS=rule,signal2,signal3,signal4
